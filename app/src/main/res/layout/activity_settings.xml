<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fixtok_background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/fixtok_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/by_manas"
            android:textColor="@color/fixtok_text_dim"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/settingsAmoled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_amoled"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/settingsMaterialYou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_material_you"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_accent_color"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsAccentColor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <!-- GUIDE / WEB VIEW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_guide"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_guide_mode"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsGuideMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <!-- VIDEO QUALITY / DOWNLOAD PREFERENCES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_video"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_video_quality"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsVideoQuality"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_video_download"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsVideoDownload"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <TextView
            android:id="@+id/settingsEmptyCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="18dp"
            android:text="@string/settings_empty_cache"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <!-- SOUND -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_sound"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settingsBass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/settings_bass"
            android:textColor="@color/fixtok_text"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/settingsAdvancedAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_advanced_audio"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <!-- D-PAD MOUSE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_mouse"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsMouseSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_mouse_speed_label"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/settingsMouseSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4" />

        <TextView
            android:id="@+id/settingsCursorSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_cursor_size_label"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/settingsCursorSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48"
            android:progress="16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_cursor_color_title"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsCursorColor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_cursor_shape_title"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settingsCursorShape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true" />

        <com.tiktok.tv.VirtualCursorView
            android:id="@+id/settingsCursorPreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/settings_cursor_preview"
            android:padding="8dp" />

        <Switch
            android:id="@+id/settingsCursorPrecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_cursor_precision"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/settingsMouseEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_mouse_enabled"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/settingsCleanScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="16dp"
            android:text="@string/settings_clean_screen"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <!-- APP / DIAGNOSTICS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_app"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsCheckUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="18dp"
            android:text="@string/settings_check_updates"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/settingsDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:padding="18dp"
            android:text="@string/settings_diagnostics"
            android:textColor="@color/fixtok_text"
            android:textSize="16sp" />

        <!-- ACCOUNT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.1"
            android:text="@string/settings_section_account"
            android:textColor="@color/fixtok_text_dimmer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_account"
                android:textColor="@color/fixtok_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/settingsAccountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fixtok_text_dim"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settingsLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/focusable_bg"
                android:focusable="true"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/settings_login"
                android:textColor="@color/fixtok_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settingsLogout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/focusable_bg"
                android:focusable="true"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/settings_logout"
                android:textColor="@color/fixtok_accent_alt"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/settingsDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/focusable_bg"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/settings_done"
            android:textColor="@color/fixtok_text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
